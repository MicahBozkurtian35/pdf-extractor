@'
# Secrets
backend/.env
frontend/.env
api_key.txt
api_key.json

# Python
__pycache__/
*.py[cod]

# Backend generated
backend/input_pdfs/
backend/output_excel/
backend/src/debug*/
backend/src/debug_pages/
backend/src/debug_uploads/
backend/src/enhanced_images/
backend/src/temp_images/
backend/src/thumbnails/
backend/src/uploads/
backend/src/upstage_cache/

# Frontend build
frontend/node_modules/
frontend/dist/
.vite/

# Misc
repo-tree.txt
FETCH_HEAD
'@ | Out-File -Append -Encoding utf8 .gitignore

git add .gitignore
git commit -m "chore: tighten .gitignore (outputs, caches, secrets, node_modules)"
